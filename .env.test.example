# Integration/media lane environment — LOCAL Supabase stack ONLY.
#
# Copy to .env.test (gitignored) after `supabase start`:
#   cp .env.test.example .env.test
#   supabase status          # fill in the Publishable / Secret values below
#
# tests/integration/setup.ts refuses to run when DATABASE_URL or SUPABASE_URL is
# missing or points anywhere other than 127.0.0.1 / localhost / ::1.
# Never put the cloud project (https://*.supabase.co) in this file.

# Server
APP_ORIGIN=http://127.0.0.1:5173
INVITE_HMAC_KEY=local-integration-invite-hmac-key

# Local Postgres (admin/superuser connection used for seeding and RLS assertions).
# createTestContext() runs ALTER ROLE app_server PASSWORD '<TEST_APP_SERVER_PASSWORD>'
# on this connection so the app_server pool can log in over TCP.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Local Auth API (supabase start -> Project URL); keys come from `supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key
SUPABASE_SECRET_KEY=your-local-secret-key

# Optional: local-only password given to the app_server role (default: memory-free constant).
# TEST_APP_SERVER_PASSWORD=xiangqi-local-app-server

# Local LiveKit SFU used by `pnpm test:media` (dev mode defaults).
LIVEKIT_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Frontend (Vite) for local test mode
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key
VITE_SUPABASE_ANON_KEY=your-local-publishable-key
