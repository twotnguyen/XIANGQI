# Production Dockerfile for XIANGQI Game Server + AI Worker
FROM node:24-alpine AS builder

WORKDIR /app

# Enable corepack for pnpm
RUN corepack enable && corepack prepare pnpm@10.34.5 --activate

# Copy root configurations
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json tsconfig.json ./

# Copy packages and server source
COPY packages/contracts/ packages/contracts/
COPY packages/game-rules/ packages/game-rules/
COPY packages/ai/ packages/ai/
COPY apps/ai-worker/ apps/ai-worker/
COPY apps/server/ apps/server/

# Install dependencies and build all workspace packages
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @xiangqi/contracts build
RUN pnpm --filter @xiangqi/game-rules build
RUN pnpm --filter @xiangqi/ai build
RUN pnpm --filter @xiangqi/ai-worker build
RUN pnpm --filter @xiangqi/server build

# Production Runner stage
FROM node:24-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3001

COPY --from=builder /app /app

EXPOSE 3001

CMD ["node", "apps/server/dist/main.js"]
