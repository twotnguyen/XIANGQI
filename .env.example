# CAU HINH TONG HOP XIANGQI — mau duy nhat cho ca du an.
# Dien .env o goc, sau do sao chep vao apps/web/.env va apps/server/.env.
# Ba file .env that chi giu tren may; khong commit. Xem CAU-HINH-MOI-TRUONG.md.
# Chi VITE_* duoc phep cong khai. Khong import ca file vao code trinh duyet,
# khong mo rong envPrefix, khong truyen toan bo process.env vao Vite define.
# Google/SMTP/CLI la thong tin chuan bi; khong tu cau hinh dashboard.
# Chua co ma ung dung/loader. Gia tri trong can duoc dien truoc khi su dung.

# 1. WEB — CONG KHAI
# Port 3000/5173 la quy uoc chuan bi, can noi voi code khi lam T01.
VITE_API_URL=http://localhost:3000
# Socket.IO du kien dung cung dia chi VITE_API_URL.
# Dien neu frontend dung Supabase SDK cho Auth.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Token LiveKit ngan han va URL nhan tu server sau khi kiem tra quyen.
# Khong luu token nguoi dung, LIVEKIT_API_SECRET hay service key tai day.

# 2. SERVER — KHONG CONG KHAI
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# Supabase > Project URL va API Keys.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Chi server: thao tac quan tri, bypass RLS; khong dung cho truy van user thong thuong.
SUPABASE_SECRET_KEY=

# LiveKit Cloud: URL wss://...livekit.cloud, API Key va API Secret cung project.
# Tu chay: thay ca 3 bang URL va cap khoa cua LiveKit server tu chay.
# ws://localhost:7880 chi phu hop thu tren cung may; LAN can dia chi truy cap duoc.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 3. DASHBOARD / CONG CU QUAN TRI
# Supabase: thong tin quan tri; khong dua vao Vite.
SUPABASE_PROJECT_REF=
# Chi can khi lien ket CLI/migration; khong can cho app runtime.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
# Chi dien neu cong cu migration/ORM ket noi Postgres truc tiep.
# Lay chuoi ket noi tu Connect; ma hoa ky tu dac biet trong mat khau URL.
DATABASE_URL=

# Nhap vao Supabase Auth > URL Configuration (khong tu dong ap dung).
AUTH_SITE_URL=http://localhost:5173
# Route /auth/callback la quy uoc de nhom trien khai, chua ton tai.
AUTH_REDIRECT_URLS=http://localhost:5173/auth/callback

# Google Auth Platform > OAuth client Web application.
# Nhap Client ID/Secret vao Google provider cua Supabase.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sao chep callback CHINH XAC tu Google provider cua Supabase.
# Dang https://PROJECT_REF.supabase.co/auth/v1/callback
GOOGLE_AUTH_REDIRECT_URI=

# SMTP NGOAI: nhap vao Supabase Auth > Custom SMTP.
# App NestJS khong can nap cac bien nay neu Supabase gui OTP.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=XIANGQI
# Ghi TLS/STARTTLS dung theo nha cung cap; day la ghi chu cau hinh.
SMTP_SECURITY=
