# Environment mode
NODE_ENV=development

# Server
PORT=3001
APP_ORIGIN=http://localhost:5173
INVITE_HMAC_KEY=change-me-in-production

# Supabase API (New format: publishable/secret recommended by Supabase)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json

# Supabase Legacy Aliases (Compatibility for tools / SDKs)
SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Database & Pooler (Recommended by Supabase: DATABASE_URL for app, DIRECT_URL for migrations)
DATABASE_URL=postgresql://postgres:***@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:***@127.0.0.1:54322/postgres
SUPABASE_DB_PASSWORD=your-db-password

# LiveKit WebRTC
LIVEKIT_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Frontend (Vite)
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_ANON_KEY=your-publishable-key
