{
  "name": "xiangqi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @xiangqi/web dev & pnpm --filter @xiangqi/server dev & wait",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "lint": "eslint 'apps/*/src/**/*.{ts,tsx}' 'packages/*/src/**/*.ts' 'tests/**/*.ts'",
    "typecheck": "tsc -b",
    "test:unit": "pnpm exec vitest run --config vitest.config.ts",
    "test:integration": "pnpm exec vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:ai": "vitest run --config vitest.config.ts tests/ai/benchmark.test.ts",
    "test:load": "vitest run --config vitest.config.ts tests/load/socket-load.test.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "livekit-server-sdk": "^2.19.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.7"
  }
}
