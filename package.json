{
  "name": "xiangqi",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.13.0 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @xiangqi/web --filter @xiangqi/server dev",
    "lint": "eslint apps packages tests",
    "format:check": "prettier --check apps packages tests package.json pnpm-workspace.yaml tsconfig.base.json eslint.config.js vitest.config.ts .github/workflows/ci.yml",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:fast": "vitest run --exclude '**/timing.test.ts'",
    "test:unit": "vitest run tests/web tests/packages",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @xiangqi/web... build",
    "build:server": "pnpm --filter @xiangqi/server... build",
    "test:core": "vitest run tests/packages/xiangqi-core --coverage",
    "test:db:account": "tests/server/db.sh test tests/server/account",
    "test:db:room": "tests/server/db.sh test tests/server/game/room",
    "test:db:match": "tests/server/db.sh test tests/server/game/match tests/server/game/clock",
    "test:db:realtime": "tests/server/db.sh test tests/server/game/realtime",
    "test:db:chat-media": "tests/server/db.sh test tests/server/game/chat tests/server/game/media",
    "test:db:ai": "tests/server/db.sh test tests/server/game/ai"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/pg": "8.15.6",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.12.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "socket.io-client": "4.8.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.12"
  },
  "type": "module"
}
