{
  "name": "xiangqi",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.13.0 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @xiangqi/web --filter @xiangqi/server dev",
    "lint": "eslint apps packages",
    "format:check": "prettier --check apps packages package.json pnpm-workspace.yaml tsconfig.base.json eslint.config.js vitest.config.ts .github/workflows/ci.yml",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "3.2.7"
  },
  "type": "module"
}
